# .env.example — copy to .env and fill in. .env is gitignored.
# The app auto-loads .env at startup; real environment variables override it.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex
ALPACA_BASE_URL=https://data.alpaca.markets
WATCHLIST=AAPL,TSLA,NVDA
POLL_INTERVAL=20s
PORT=8080
# pprof/admin server bind. Keep loopback unless the admin port is firewalled; set to '-' to disable.
PPROF_ADDR=127.0.0.1:6060
CORS_ORIGIN=*
# Leave OTEL endpoint unset to use the stdout exporter for local dev.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=alpaca-playground
